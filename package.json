    "@iconify-json/lucide": "^1.2.98",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^5.1.0",
    "@japa/runner": "^4.2.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.13.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.7",
    "vite": "^7.3.1",
    "youch": "^4.1.0"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/content": "^1.6.1",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.0",
    "@adonisjs/vite": "^5.1.0",
    "@alpinejs/mask": "^3.15.5",
    "@imacrayon/alpine-ajax": "^0.12.4",
    "@tailwindcss/vite": "^4.1.6",
    "@vinejs/vine": "^4.3.0",
    "alpinejs": "^3.14.9",
    "bulma": "^1.0.4",
    "daisyui": "^5.0.35",
    "edge-iconify": "^2.0.2",
    "edge.js": "^6.5.0",
    "flowbite": "^3.1.2",
    "htmx.org": "^1.9.12",
    "luxon": "^3.6.1",
    "motion": "^12.23.12",
    "mysql2": "^3.14.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^11.1.0"
  },
  "hotHook": {
    "boundaries": [
