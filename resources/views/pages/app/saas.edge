<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @vite(['resources/css/saas.css', 'resources/js/saas.js'])
    <title>
      Emsync Salon App
    </title>
  </head>
  <body>
    <header class=" w-full h-[51px] flex justify-center items-center">
      <nav class=" max-w-[1200px] w-full flex justify-between">
        <div class="flex gap-2">
          <img class=" size-8" src="" alt="" />
          <div class="flex gap-4">
            <h3>
              Emsync salon
            </h3>
            <p>
              Nome da loja
            </p>
          </div>
        </div>
        <div class="flex gap-3">
          <a class=" flex justify-center items-center bg-gray-400 px-4 py-1 rounded-sm" href="">
            <button class=" cursor-pointer">ir para o website</button>
          </a>
          <img class=" size-11 border rounded-full" src="" alt="" />
        </div>
      </nav>
    </header>
    <main class="w-full h-full flex">
      <aside>
        <div>
          <h3>
            menu
          </h3>
        </div>
        <div>
          <ul>
            <li>
              home
            </li>
            <li>
              serviços
            </li>
            <li>
              inventario
            </li>
            <li>
              gerenciamento de staff
            </li>
            <li>
              agendamentos
            </li>
            <li>
              clientes
            </li>
            <li>
              configurções
            </li>
          </ul>
        </div>
        <div>
        </div>
      </aside>
      <section>
        <div>
          <h2>
            Home Dashboard
          </h2>
        </div>
        <div class="">
          <h4>
            Aplicações
          </h4>
          <div
            class="flex justify-center items-center gap-3.5 rounded-lg border border-gray-200 bg-white text-gray-800 shadow-2xs"
          >
            <button>
              <img class=" size-9" src="" alt="" />
            </button>
            <button>
              <img class=" size-9" src="" alt="" />
            </button>
          </div>
        </div>
        <div>
        </div>
        <div>
        </div>
      </section>
    </main>
    <footer>

    </footer>
  </body>
</html>
