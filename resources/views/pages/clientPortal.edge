<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    <title>
      App
    </title>
  </head>
  <body>
    @portalNavbar({data:{storeName: pagedata.storeName} }) 
      
    @end
    <main class="flex">
      <aside class=" hidden max-h-4/5 max-w-[300px] top-[300px] h-full w-full rounded-lg border border-gray-200 bg-white text-gray-800 shadow-2xs sm:inline">
        
        <div class="flex flex-col justify-center items-center gap-5">
          menu
          <div class=" w-full text-start pl-5 bg-gray-400">Produtos</div>
          <div class=" w-full text-start pl-5 bg-gray-400">Serviços</div>
          <div class=" w-full text-start pl-5 bg-gray-400">Meus Pedidos</div>
          <div class=" w-full text-start pl-5 bg-gray-400">Avaliações</div>
          <div class=" w-full text-start pl-5 bg-gray-400">Configurações</div>
        </div>
        
      </aside>
      <section 
        id="main-content" 
        class="w-full rounded-lg border border-gray-200 bg-white text-gray-800 shadow-2xs m-9"
        hx-get="/portaldocliente/view/service"
        hx-trigger="load"
        hx-target="#main-content"
      >
        {{-- menu skeleton loader --}}
        <div class="animate-pulse ">
            <h1 class=" flex-1 space-y-6 py-1 bg-gray-200"></h1>
            <div class="flex flex-col">
                <div class="flex flex-col">
                    <div class="flex justify-between">
                        <p class=" flex-1 space-y-6 py-1 bg-gray-200"></p>
                        <i class="w-[20px] h-[20px]" data-lucide="panel-top-open"></i>
                    </div>
                    <div>

                    </div>
                </div>
            </div>
        </div>
      </section>
    </main>
  </body>
</html>
