<div id="signupContent" class=" flex flex-col gap-7 justify-center items-center p-7 h-full text-main-blue">
    <img class=" size-20" src="" alt="">
    <div>
        <h1 class=" text-2xl text-center text-main font-bold">
            <span class="text-main-blue font-semibold" x-text="$store.signup.userName"></span><br> cadastro da loja
        </h1>
    </div>
    <form action="" class="flex flex-col gap-5 w-full">
        <div class="w-full">
            <h3 class="text-center text-base font-light">Precisamos de alguns dados da sua<br>loja para começar</h3>
        </div>
        <div class="flex flex-col gap-0.5">
            <label class=" text-[12px]" for="storeName">Name da Loja</label>
            <input 
                class=" border-[0.5px] py-1 px-2 rounded-lg text-main-blue bg-main-gray border-gray-300 focus:outline-none focus:border-main" 
                type="text" 
                name="storeName" 
                id="storeName" 
                x-model="$store.signup.storeName"
            >
        </div>
        <div class="flex flex-col gap-0.5">
            <label class=" text-[12px]" for="storeCNPJ">CNPJ</label>
            <input 
                class=" border-[0.5px] py-1 px-2 rounded-lg text-main-blue bg-main-gray border-gray-300 focus:outline-none focus:border-main"
                :class="$store.signup.cnpjError ? 'border-red-500' : 'border-gray-300'"
                type="text" 
                name="storeCNPJ" 
                id="storeCNPJ"
                placeholder="00.000.000/0001-00"
                x-model="$store.signup.storeCNPJ"
                x-mask="99.999.999/9999-99"
                @input="$store.signup.validateCNPJ($event.target.value)"
            >
            <span 
                x-show="$store.signup.cnpjError" 
                class="text-red-500 text-[10px] mt-1" 
                x-text="$store.signup.cnpjError">
            </span>
        </div>
        <div class="flex flex-col gap-0.5">
            <label class=" text-[12px]" for="storeEmail">Email</label>
            <input 
                class=" border-[0.5px] py-1 px-2 rounded-lg text-main-blue bg-main-gray border-gray-300 focus:outline-none focus:border-main"
                :class="$store.signup.emailError ? 'border-red-500' : 'border-gray-300'"  
                type="email" 
                name="storeEmail" 
                id="storeEmail" 
                required 
                autocomplete="email"
                placeholder="exemplo@email.com"
                x-model="$store.signup.storeEmail"
                @input="$store.signup.validateEmail($event.target.value)"
                @blur="$store.signup.validateEmail($event.target.value)"
            >
            <span 
                x-show="$store.signup.emailError" 
                class="text-red-500 text-[10px] mt-1" 
                x-text="$store.signup.emailError">
            </span>
        </div>
        <div class="flex flex-col gap-0.5">
            <label class=" text-[12px]" for="storePhone">Whatsapp ou Whatsapp Business</label>
            <div class="w-full flex items-center gap-1">
                <span class="h-full flex justify-center items-center border-[0.5px] py-1 px-2 rounded-lg text-main-blue bg-main-gray border-gray-300 text-sm">+55</span>
                <input 
                    class=" w-full border-[0.5px] py-1 px-2 rounded-lg text-main-blue bg-main-gray border-gray-300 focus:outline-none focus:border-main" 
                    type="tel" 
                    name="storePhone" 
                    id="storePhone"
                    placeholder="(11) 99999-9999"
                    x-mask="(99) 99999-9999"
                    x-model="$store.signup.storePhone"
                >
            </div>
        </div>
    </form>
    <div class=" w-full flex justify-evenly gap-3">
        @component('components/signup/button', {
            main:false,
            getLink:'/signup/view/signup',
            text:'Voltar'
        })  
        @end
        @component('components/signup/button', {
            main:true,
            getLink:'/signup/view/plan',
            text:'Continuar'
        })  
        @end
    </div>
</div>