<div class="flex flex-col gap-1.5 rounded-sm border-[0.5px] border-borderGray p-2.5">
    <h3 class=" text-lg">Pedidos Recentes</h3>
    @each(card in content.orders)
        <div class="flex gap-1.5 rounded-sm h-[87px] border-[0.5px] border-borderGray shadow-sm">
            <img class=" min-w-[64px] w-[64px] h-full object-cover " width="854" height="480" src={{card.image}} alt="">
            <div class="flex flex-col w-full gap-1 p-2.5>
                <div class="flex flex-col gap-1.5">
                    <h4 class=" text-base">{{card.title}}</h4>
                    <p class=" w-fit h-fit px-3 text-[12px] font-bold bg-gray-300 text-white rounded-sm">{{card.status}}</p>
                </div>
                <div class="flex justify-between text-sm font-light">
                    <p>Data: {{card.date}}</p>
                    <p>Horario: {{card.time}}</p>
                </div>
            </div>
        </div> 
    @end
</div>