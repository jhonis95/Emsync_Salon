<div class="flex flex-col gap-1.5 rounded-sm border-[0.5px] border-borderGray p-2.5">
    <h3 class=" text-lg">Próximos Agendamentos</h3>
    @each(card in content.nextAppointment)
        <div class="flex gap-1.5 h-[87px] rounded-sm border-[0.5px] border-borderGray shadow-sm">
            <img class="min-w-[64px] w-[64px] h-full object-cover " width="854" height="480" src="https://img.freepik.com/fotos-gratis/jovem-no-barbeiro-a-cortar-o-cabelo_1303-26254.jpg?t=st=1766536429~exp=1766540029~hmac=6805f95d7fbacf06ea212717079d10c77ae6bc7fa6e9383bbd8708a953fb34c9&w=1480" alt="">
            <div class="flex flex-col w-full gap-1 p-2.5">
                <div>
                    <h4 class=" text-base">{{ card.title}}</h4>
                    <p class=" text-sm font-light">{{ card.text}}</p>
                </div>
                <div class="flex justify-between text-sm font-light">
                    <p>Data: {{card.date}}</p>
                    <p>Horario: {{card.time}}</p>
                </div>
            </div>
        </div>
    @end
</div>