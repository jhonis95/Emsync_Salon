<header
  x-data="{dropdownOpen:false}"
  class=" h-16 shrink-0 fixed w-full min-h-[64px] top-0 z-50 gap-x-2 rounded-b-2xl border-b border-x border-gray-200 bg-white shadow-2xs "
>
  <nav class=" max-w-[85rem] w-full h-full flex px-4 py-2.5">
    <div class=" w-full flex justify-between items-center">

      {{-- container logo e texto --}}
      <div class="flex items-center gap-3 font-poppins">
        <div class=" size-12 flex items-center justify-center rounded-lg bg-unfocus-bg">
          <!-- Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon lucide-house text-unfocus"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        </div>

        <div class="flex flex-col leading-tight">
          <span class="font-semibold text-main-dark text-lg">
            Nome da Loja
          </span>
          <span class="text-sm text-main font-medium">
            Portal do cliente
          </span>
        </div>
      </div>

      <div class="w-10 h-10 flex items-center justify-center rounded-full bg-unfocus-bg">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-icon lucide-user text-unfocus"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>

    </div>
  </nav>
</header>
