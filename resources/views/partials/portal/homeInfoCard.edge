<div class="rounded-sm border-[0.5px] bg-white border-unfocus-bg shadow-lg">
  <div class="flex justify-between p-5">
    <div class=" flex gap-2">
      <img class=" size-6" src={{card.image}} alt="" />
      <h4 class=" font-poppins font-semibold text-base">
        {{ card.title }}
      </h4>
    </div>
    <p class=" text-base font-bold text-main">
      {{ card.number }}
    </p>
  </div>
</div>
