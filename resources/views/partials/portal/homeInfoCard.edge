<div class="flex flex-col rounded-sm border-[0.5px] border-borderGray p-2 shadow-lg">
    <div class="flex justify-between gap-2.5">
        <h4 class=" text-sm">{{ card.title}}</h4>
        <img class=" size-4" src={{card.image}} alt="">
    </div>
    <p class=" text-sm">{{ card.content }}</p>
</div>