<div class="flex flex-col gap-1.5 rounded-lg border-[0.5px] border-unfocus-bg p-5 shadow-lg">
  <div class="flex gap-1">
    @svg(card.icon.name,{
      width: card.icon.width,
      height: card.icon.height,
      class: card.icon.color
    })
    <h4 class=" text-base font-semibold font-poppins">
      {{ card.title }}
    </h4>
  </div>
  <p class=" text-sm font-light">
    {{ card.text }}
  </p>
  @component('components/portal/button', { 
    text: card.buttonText
   })
    
  @end
</div>

