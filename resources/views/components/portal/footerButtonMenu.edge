<button
  type="button"
  class=" w-fit flex flex-col justify-center items-center"
  :class="$store.portal.portalPage === '{{ title }}'
    ? ' text-main '
    : ' text-unfocus'"
  x-on:click="$store.portal.setPortalPage('{{ title }}', '{{ getLink }}')"
>
  <div :class="$store.portal.portalPage === '{{ title }}' ? 'text-main' : 'text-unfocus'">
    {{{ await $slots.main() }}}
  </div>
  <p class=" max-w-17.5 truncate w-full font-medium">
    {{ title }}
  </p>
</button>