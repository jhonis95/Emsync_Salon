<div class=" w-[276px] rounded-lg border border-gray-200 bg-white text-gray-800 shadow-2xs">
    <img class="" src="" alt=""/>
    <div class=" m-2">
        <div class="flex justify-between">
            <h4 class="font-medium text-base">{{ service.name }}</h4>
            <h6 class="font-light text-base">R$ {{ service.price }}</h6>
        </div>
        <p class="text-xs text-justify line-clamp-5">{{ service.description}}</p>
    </div>
</div>
